---                               
import '../styles/global.css'
import { ClientRouter } from "astro:transitions";
---  

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline data-goatcounter="https://justcabyr.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
		<title>AbdulKabir's Website</title>
	</head>
	<body class="bg-[#f9f7f1] text-[#1a1a1a] font-sans">
		<main class="max-w-3xl mx-auto px-6 py-10 pb-24">
			<slot />
		</main>
	</body>
	<footer class="fixed bottom-0 left-0 right-0 text-center text-sm text-gray-500 py-4 bg-[#f9f7f1]">
		<p>
			This website is built with 🙌
		</p>
	</footer>
</html>

<style>
	html,
	body {
		margin: 0;
	}
</style>
<ClientRouter />
