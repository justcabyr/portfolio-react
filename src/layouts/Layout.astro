---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  bodyClass?: string;
  footerClass?: string;
}

const { bodyClass, footerClass } = Astro.props;
const bodyDefault = 'bg-[#f9f7f1] text-[#1a1a1a]';
const footerDefault = 'bg-[#f9f7f1]/80 text-gray-500 backdrop-blur-sm';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script
      is:inline
      data-goatcounter="https://justcabyr.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
    <title>AbdulKabir's Website</title>
  </head>
  <body class:list={['font-sans', bodyClass ?? bodyDefault]}>
    <div class="bg-blobs" aria-hidden="true">
      <span class="blob blob-a"></span>
      <span class="blob blob-b"></span>
      <span class="blob blob-c"></span>
    </div>
    <main class="page-shell mx-auto max-w-3xl px-6 py-10 pb-24">
      <slot />
    </main>
  </body>
  <footer
    class:list={[
      'site-footer fixed bottom-0 left-0 right-0 py-4 text-center text-sm',
      footerClass ?? footerDefault,
    ]}
  >
    <p>Free Palestine 🇵🇸</p>
  </footer>
</html>

<style>
  html,
  body {
    margin: 0;
  }
</style>
<ClientRouter />
