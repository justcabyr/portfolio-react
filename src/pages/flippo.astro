---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
---

<Layout>
  <NavBar />
  <h1 class="mb-6 font-serif text-5xl font-bold">Flippo</h1>
  <div class="space-y-6 text-lg leading-relaxed">
    <section class="space-y-3">
      <h2 class="text-2xl font-bold">About Flippo</h2>
      <p class="font-semibold">
        Connect with friends. Share your vibe.
      </p>

      <div class="space-y-4">
        <div class="space-y-2">
          <h3 class="text-xl font-semibold">About</h3>
          <p>
            Flippo is a mobile app for staying close to the people who matter.
            Add friends with invite codes, show your personality with a profile
            color, and keep your list yours with block and report controls. Sign
            in with Google or Apple. Flippo is a social network for sharing
            colours.
          </p>
        </div>

        <div class="space-y-2">
          <h3 class="text-xl font-semibold">Promotional text</h3>
          <p class="font-semibold">
            Your circle, your way.
          </p>
          <p>
            Add friends in one tap. Share your invite code. Pick a color that’s
            you. Flippo keeps connections simple and under your control.
          </p>
        </div>

        <div class="space-y-2">
          <h3 class="text-xl font-semibold">Description</h3>
          <p>
            Flippo is a lightweight social app that focuses on your friend list
            instead of feeds and algorithms. After signing in with Google, or Apple, you get a unique invite code to share. Friends
            join your list by entering your code, and you can accept theirs.
            Each profile supports a custom color so your list feels personal.
            You can remove friends, block or unblock users, and report when
            needed.
          </p>
        </div>

        <div class="space-y-1">
          <h3 class="text-xl font-semibold">Keywords</h3>
          <p class="text-sm text-gray-700">
            friends · social · invite · connect · profile · mobile · iOS · Android · privacy · block · report · invite code
          </p>
        </div>
      </div>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold">Legal</h2>
      <p>
        You can review Flippo&apos;s legal documents using the links below.
      </p>
      <ul class="list-disc space-y-2 pl-6 text-base">
        <li>
          <a href="/flippo/privacy" class="text-orange-600 hover:underline">
            Privacy Policy
          </a>
        </li>
        <li>
          <a href="/flippo/terms" class="text-orange-600 hover:underline">
            Terms of Service
          </a>
        </li>
      </ul>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold">Support</h2>
      <p>
        Need help using Flippo? Have feedback or run into an issue? I&apos;m
        happy to hear from you.
      </p>
      <p>
        📧
        {' '}
        Email me at
        {' '}
        <a
          href="mailto:justcabyr@gmail.com"
          class="text-orange-600 hover:underline"
        >
          justcabyr@gmail.com
        </a>
      </p>
    </section>
  </div>
</Layout>
