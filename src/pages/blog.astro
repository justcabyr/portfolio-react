---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';

import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort(
  (b, a) => a.data.pubDate.getTime() - b.data.pubDate.getTime()
);
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<Layout>
  <NavBar />
  <h1 class="mb-6 font-serif text-5xl font-bold">Blog</h1>
  <div class="space-y-6 text-lg leading-relaxed">
    {
      posts.map((post) => (
        <div class="space-y-1">
          <a href={`/posts/${post.id}`} class="text-orange-600 hover:underline">
            <p class="text-xl font-semibold">{post.data.title}</p>
          </a>
          <p class="text-base text-[#4a4a4a]">{post.data.description}</p>
          <p class="text-sm text-[#6b6b6b]">{dateFormatter.format(post.data.pubDate)}</p>
        </div>
      ))
    }
  </div>
</Layout>
