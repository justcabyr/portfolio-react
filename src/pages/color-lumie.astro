    <section class="space-y-3">
      <h2 class="text-2xl font-bold">Legal</h2>
      <p>
        You can review Color Lumie&apos;s legal documents using the links below.
      </p>
      <ul class="list-disc space-y-2 pl-6 text-base">
        <li>
          <a href="/color-lumie/privacy" class="text-orange-600 hover:underline">
            Privacy Policy
          </a>
        </li>
        <li>
          <a href="/color-lumie/terms" class="text-orange-600 hover:underline">
            Terms of Service
          </a>
        </li>
      </ul>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold">Support</h2>
      <p>
        Need help using Color Lumie? Have feedback or run into an issue? I&apos;m
        happy to hear from you.
      </p>
      <p>
        📧
        {' '}
        Email me at
        {' '}
        <a
          href="mailto:justcabyr@gmail.com"
          class="text-orange-600 hover:underline"
        >
          justcabyr@gmail.com
        </a>
      </p>
    </section>
  </div>
</Layout>
