            href="https://www.youtube.com/watch?v=HrRQ1Ed5JeU&list=PL98EgvHCY8xc8Rxs7P7Yv4I1OOdZW3mTZ&index=2"
            class="text-orange-600 hover:underline">Kubernetes Workshop</a
          >
          — Sep 2025
        </li>
        <li>
          <a
            href="https://jackharrhy.dev/workshops/2025/astro-workshop"
            class="text-orange-600 hover:underline">Astro Workshop</a
          >
          — Jul 2025
        </li>
        <li>
          <a
            href="https://gdg.community.dev/events/details/google-gdg-st-johns-presents-devfest-st-johns-2025/"
            class="text-orange-600 hover:underline">Docker Workshop</a
          >
          — June 2025
        </li>
        <li>
          <a
            href="https://gdg.community.dev/events/details/google-gdg-st-johns-presents-devfest-st-johns-2025/"
