---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
---

<Layout>
  <NavBar />
  <h1 class="mb-6 font-serif text-5xl font-bold">Community</h1>
  <div class="space-y-6 text-lg leading-relaxed">
    <p>I really love volunteering and supporting local tech communities:</p>
    <ul>
      <li>
        Chapter Founder and Lead - <a
          href="https://gdg.community.dev/gdg-st-johns/"
          class="text-orange-600 hover:underline"
          >Google Developer Groups St. John's</a
        >
      </li>
      <li>
        Director, Programs and Impact - <a
          href="https://www.linkedin.com/company/technestcommunity/"
          class="text-orange-600 hover:underline">TechNest Community</a
        >
      </li>
      <li>
        Growth - <a
          href="https://ctsnl.ca/"
          class="text-orange-600 hover:underline"
          >Computer Technology Society of Newfoundland and Labrador (CTS-NL)</a
        >
      </li>
    </ul>
    <section class="space-y-3">
      <h2 class="font-serif text-3xl font-bold">Events I've Hosted - WIP</h2>
      <p>Here are a few sample talks/workshops/events I've given/organized:</p>
      <ul>
        <li>
          <a
            href="https://gdg.community.dev/events/details/google-gdg-st-johns-presents-devfest-st-johns-2025/"
