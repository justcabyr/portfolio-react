---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import { getDevToPosts, getDevToArticle } from '../../lib/devto';

export async function getStaticPaths() {
  const posts = await getDevToPosts();
  const paths = [];
  for (const summary of posts) {
    const post = await getDevToArticle(summary.id);
    paths.push({
      params: { slug: post.slug },
      props: { post },
    });
  }
  return paths;
}

const { post } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout>
  <NavBar />
  <article class="mb-8 flex flex-col gap-6">
    <header class="space-y-2">
      <p class="text-sm text-[#6b6b6b]">
        <a href="/" class="text-orange-600 hover:underline">
          Blog
        </a>
        {' · '}
        {post.published_at
          ? dateFormatter.format(new Date(post.published_at))
          : ''}
      </p>
      <h1 class="font-serif text-4xl font-bold">{post.title}</h1>
      {post.description ? (
        <p class="text-lg text-[#4a4a4a]">{post.description}</p>
      ) : null}
      <p>
        <a
          href={post.url}
          class="text-sm text-orange-600 hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on dev.to
        </a>
      </p>
    </header>
    <div class="markdown-content" set:html={post.body_html} />
  </article>
</Layout>
