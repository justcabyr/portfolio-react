---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import projects from '../data/projects.json';
---

<Layout>
  <NavBar />
  <h1 class="mb-6 font-serif text-5xl font-bold">Projects</h1>
  <div class="space-y-6 text-lg leading-relaxed">
    {
      projects.map(
        (project: {
          year: number;
          tree: { name: string; link: string; description: string }[];
        }) => (
          <div>
            <h2 class="text-2xl font-bold">{project.year}</h2>
            <div class="mt-4 space-y-4">
              {project.tree.map(
                (item: { name: string; link: string; description: string }) => (
                  <div>
                    <a href={item.link} class="text-orange-600 hover:underline">
                      <p class="font-medium">{item.name}</p>
                    </a>
                    <p class="text-gray-600">{item.description}</p>
                  </div>
                )
              )}
            </div>
          </div>
        )
      )
    }
  </div>
</Layout>
