---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import projects from '../data/projects.json';
---

<Layout>
  <NavBar />
  <h1 class="scribble-title mb-2 font-serif text-5xl font-bold">Projects</h1>
  <p class="mb-8 text-base text-[#4a4a4a]">Things I&apos;ve built or tinkered with.</p>
  <div class="stagger space-y-6 text-lg leading-relaxed">
    {
      projects.map((project) => (
        <div class="fun-row space-y-1">
          <a
            href={project.url}
            class="text-orange-600 hover:underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            <p class="text-xl font-semibold">{project.name}</p>
          </a>
          {project.description ? (
            <p class="text-base text-[#4a4a4a]">{project.description}</p>
          ) : null}
        </div>
      ))
    }
  </div>
</Layout>
