---
const path = Astro.url.pathname;
const onAbout = path === '/' || path === '';
const onBlog = path === '/blog' || path.startsWith('/blog/');
const onProjects = path === '/projects';
const onNow = path === '/now';

const link = (active: boolean) =>
  [active && 'text-orange-600', 'hover:underline'].filter(Boolean).join(' ');

const brandClass = [
  'text-lg font-medium',
  onAbout && 'text-orange-600',
].filter(Boolean).join(' ');
---

<header class="mb-10">
  <div class="flex items-center justify-between">
    <a href="/" class={brandClass}>
      <span>AbdulKabir</span>
    </a>

    <nav class="space-x-6 text-sm">
      <a href="/blog" class={link(onBlog)}>Blog</a>
      <a href="/projects" class={link(onProjects)}>Projects</a>
      <a href="/now" class={link(onNow)}>Now</a>
    </nav>
  </div>
  <hr class="mt-6 border-0 border-t border-gray-200" />
</header>
